{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "dotnet-algorand-sdk.csproj"
          ],
          "src": "../dotnet-algorand-sdk"
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/**.md"
        ],
        "exclude": [
          "obj/**"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Algorand .NET SDK",
      "_appTitle": "Algorand .NET SDK",
      "_appFooter": "<span>Algorand .NET SDK (Algorand5) &mdash; <a href=\"https://github.com/scholtz/dotnet-algorand-sdk\">GitHub</a> &middot; <a href=\"https://www.nuget.org/packages/Algorand5/\">NuGet</a></span>",
      "_enableSearch": true,
      "_disableNextArticle": false
    },
    "markdownEngineName": "markdig"
  }
}
